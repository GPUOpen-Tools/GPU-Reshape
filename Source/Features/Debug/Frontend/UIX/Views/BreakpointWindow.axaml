<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GRS.Features.Debug.UIX.ViewModels"
        xmlns:views="clr-namespace:UIX.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UIX.Views.BreakpointWindow"
        x:DataType="viewModels:BreakpointViewModel"
        Width="1280" Height="720"
        Title="BreakpointDisplay">
    <views:BreakpointDisplayView/>
</Window>
