<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GRS.Features.Debug.UIX.ViewModels"
             xmlns:controls="clr-namespace:UIX.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UIX.Views.Display.StructuredBreakpointDisplayView"
             x:DataType="viewModels:StructuredBreakpointDisplayViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid>
        <ScrollViewer 
            x:Name="Scroller"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible">
            <controls:StructuredGrid x:Name="Grid" DataContext="{Binding}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
