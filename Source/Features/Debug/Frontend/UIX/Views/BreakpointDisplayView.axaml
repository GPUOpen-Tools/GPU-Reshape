<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GRS.Features.Debug.UIX.ViewModels"
             xmlns:controls="clr-namespace:Studio.Views.Controls;assembly=UIX.Studio.Runtime"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UIX.Views.BreakpointDisplayView"
             x:DataType="viewModels:BreakpointViewModel">
    <Grid Background="{StaticResource InfoBackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        
        <!-- Configuration -->
        <Grid Grid.Row="0" Margin="3 2 3 2">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <!-- Archetype -->
                <ComboBox SelectedItem="{Binding ArchetypeViewModel}" ItemsSource="{Binding Archetypes}" DisplayMemberBinding="{Binding Name}"/>
                
                <!-- Display -->
                <controls:LocatorViewHost 
                    Margin="5 0 0 0"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    ViewType="Config"
                    DataContext="{Binding DisplayViewModel}"/>
            </StackPanel>
            
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Label Content="{Binding FrameRate, FallbackValue=32, StringFormat='FPS: {0}'}" />
                
                <ToggleButton
                    Margin="0 0 0 0" 
                    Background="Transparent"
                    BorderThickness="0"
                    Height="25"
                    Width="25"
                    IsChecked="{Binding Paused}">
                    <PathIcon Data="{StaticResource Pause}" Margin="0 1 1 0" Width="10" />
                </ToggleButton>
            </StackPanel>
        </Grid>
        
        <!-- Display -->
        <Grid Grid.Row="1">
            <Border 
                Height="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource LineBorderBrush}"/>
            
            <controls:LocatorViewHost 
                Margin="0 1 0 0"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                DataContext="{Binding DisplayViewModel}" />
        </Grid>
        
        <!-- Info -->
        <Grid Grid.Row="2">
            <StackPanel 
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <Label Content="{Binding Decoration}"/>
            </StackPanel>
            
            <StackPanel
                IsVisible="{Binding IsOutOfMemory}"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Height="25">
                <PathIcon
                    VerticalAlignment="Center"
                    Margin="0 1 0 0"
                    Data="{StaticResource Warning}" Width="14" Height="14"/>
                
                <TextBlock 
                    Margin="5 0 0 0"
                    VerticalAlignment="Center"
                    Text="Out of breakpoint memory"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
